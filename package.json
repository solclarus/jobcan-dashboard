{
  "name": "jobcan-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Dashboard for visualizing Jobcan attendance data with charts",
  "author": "solclarus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solclarus/jobcan-dashboard.git"
  },
  "keywords": [
    "jobcan",
    "attendance",
    "dashboard",
    "react",
    "recharts",
    "visualization"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "preview": "vite preview",
    "tsc": "tsc",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.564.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "lefthook": "^2.1.0",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "postcss": "^8.5.6",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
